# TalentAI — Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Selection (Groq)
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant

# ChromaDB settings
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_RESUMES=talent_resumes
CHROMA_COLLECTION_JOBS=talent_jobs

# Server settings
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# Minimum candidates before replanning
MIN_CANDIDATES_THRESHOLD=3
